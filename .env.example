# Copy this file to .env and change the values. NEVER push .env to GitHub.

# Secret prefix used to derive the 4 agent seeds (any long random text).
SEED_PREFIX=change-this-to-some-long-random-text

# 1 = demo mode (lets you type "pay" in chat to simulate payment)
DEMO_MODE=1

# 1 = force the "live price API" to fail, to demo error handling / fallback
DEMO_FAIL_PRICE_API=0

# Optional: your real price API (must return {"rice": {"SupplierName": 46.0}, ...})
PRICE_API_URL=

# Payment settings - confirm exact values with the Fetch.ai workshop/docs
PAYMENT_CURRENCY=USDC
PAYMENT_METHOD=skyfire
INR_PER_USDC=85
